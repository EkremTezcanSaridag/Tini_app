<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen Theme -->
    <style name="Theme.Tini.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface_white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Tini</item>
    </style>
    
    <!-- Main App Theme -->
    <style name="Theme.Tini" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/surface_white</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
